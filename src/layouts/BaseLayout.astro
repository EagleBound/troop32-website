---
// Shared page shell: <head>, skip link, header, main landmark, footer.
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';

interface Props {
  /** Page title. The site name is appended automatically. */
  title?: string;
  /** Short description for search results and link previews. */
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}, ${site.locality}` : `${site.name} | ${site.locality}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!site.indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1d3a2a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={site.name} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: var(--space-4);
    top: -10rem;
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    background: var(--cream-50);
    color: var(--forest-900);
    font-weight: 700;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  .skip-link:focus {
    top: var(--space-4);
  }

  main:focus {
    outline: none;
  }
</style>
