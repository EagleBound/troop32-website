---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MeetingCard from '../components/MeetingCard.astro';
import { site } from '../data/site';

// The public role-based contact address is pending leadership confirmation.
// When it is approved, set `site.contact.email` in src/data/site.ts and the
// email section below appears automatically. Never add personal contact details.
const email = site.contact.email;
---

<BaseLayout
  title="Contact"
  description={`How to reach ${site.name} in ${site.locality}: visit a meeting ${site.meeting.day} at ${site.meeting.time}.`}
>
  <PageHeader
    eyebrow="Contact"
    title={`Get in touch with ${site.name}`}
    intro={`The best way to reach ${site.name} is in person. Come to a meeting, where Scouts and troop leaders are happy to answer your questions.`}
  />

  <section class="section" aria-labelledby="contact-title">
    <div class="container contact-layout">
      <div class="reading">
        <h2 id="contact-title">Talk with us in person</h2>
        <p>
          {site.name} meets on {site.meeting.day} at {site.meeting.time} at {site.meeting.place}. Visiting a meeting is
          the quickest way to ask questions about joining, see the troop in action, and meet the people who make it
          work.
        </p>
        {
          email && (
            <section class="email-block" aria-labelledby="email-title">
              <h2 id="email-title">Email the troop</h2>
              <p>
                <a href={`mailto:${email}`}>{email}</a>
              </p>
            </section>
          )
        }
        <h2>About this website</h2>
        <p>
          Read how this website handles <a href="/privacy/">privacy</a> and our commitment to
          <a href="/accessibility/">accessibility</a>.
        </p>
      </div>
      <aside aria-label="Meeting time and place">
        <MeetingCard headingLevel={2} title="Visit a meeting" />
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .contact-layout {
      grid-template-columns: 1.5fr 1fr;
      align-items: start;
    }
  }

  .email-block {
    margin-block: var(--space-6);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .email-block p {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 700;
  }
</style>
