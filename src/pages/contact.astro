---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import MeetingCard from '../components/MeetingCard.astro';
import { site } from '../data/site';

// The public way to reach the troop is the role-based Scoutmaster address in
// `site.contact.email` (src/data/site.ts). Prospective families plan a visit
// through the Scoutmaster; recurring meeting logistics are not public (P2).
// Never add personal contact details.
const email = site.contact.email;
---

<BaseLayout
  title="Contact"
  description={`How to reach ${site.name} in ${site.locality}: get in touch with the Scoutmaster, and we'll help prospective families plan a visit to a meeting.`}
>
  <PageHeader
    eyebrow="Contact"
    title={`Get in touch with ${site.name}`}
    intro={`The best way to reach ${site.name} is to get in touch with the Scoutmaster. Prospective families are always welcome to visit a meeting, and we'll help you plan it.`}
  />

  <section class="section" aria-labelledby="contact-title">
    <div class="container contact-layout">
      <div class="reading">
        <h2 id="contact-title">Visit a meeting</h2>
        <p>
          Visiting a meeting is the best way to ask questions about joining, see the troop in action, and meet the
          people who make it work. Get in touch with the Scoutmaster and we'll help you plan a visit.
        </p>
        {
          email && (
            <section class="email-block" aria-labelledby="email-title">
              <h2 id="email-title">Email the Scoutmaster</h2>
              <p class="email-intro">Questions about joining or about {site.name}? Write to the Scoutmaster at:</p>
              <p class="email-address">
                <a href={`mailto:${email}`}>{email}</a>
              </p>
            </section>
          )
        }
        <h2>About this website</h2>
        <p>
          Read how this website handles <a href="/privacy/">privacy</a> and our commitment to{' '}
          <a href="/accessibility/">accessibility</a>.
        </p>
      </div>
      <aside aria-label="Our weekly meetings">
        <MeetingCard headingLevel={2} />
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .contact-layout {
      grid-template-columns: 1.5fr 1fr;
      align-items: start;
    }
  }

  .email-block {
    margin-block: var(--space-6);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius-lg);
  }

  .email-block p {
    margin: 0;
  }

  .email-block .email-intro {
    margin-bottom: var(--space-2);
  }

  .email-block .email-address {
    font-size: var(--text-lg);
    font-weight: 700;
  }
</style>
