---
// /events/: Upcoming, Recent Adventures, and a way into the Troop 32 Archive.
// Which event appears where is decided by src/lib/events/classify.ts at build time.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventList from '../../components/events/EventList.astro';
import { getEventViews } from '../../lib/events/collection';
import { site } from '../../data/site';

const { upcoming, recent, archive } = await getEventViews();
---

<BaseLayout
  title="Events"
  description={`Selected ${site.name} events, stories from recent adventures, and the ${site.name} Archive.`}
>
  <PageHeader
    eyebrow="Events"
    title="Events and adventures"
    intro={`Selected upcoming events, stories from recent adventures, and the ${site.name} Archive.`}
  />

  <section class="section section--tight" aria-labelledby="upcoming-title">
    <div class="container">
      <h2 id="upcoming-title">Upcoming events</h2>
      <EventList events={upcoming}>
        <p slot="empty">
          Upcoming adventures are shared here when appropriate for the public. Interested in {site.name}?
          <a href="/join/">Learn more about visiting a {site.meeting.dayName} meeting</a>.
        </p>
      </EventList>
    </div>
  </section>

  <section class="section section--tight section--surface" aria-labelledby="recent-title">
    <div class="container">
      <h2 id="recent-title">Recent Adventures</h2>
      <EventList events={recent}>
        <p slot="empty">Stories and photos from recent {site.name} adventures will appear here.</p>
      </EventList>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="archive-title">
    <div class="container reading">
      <h2 id="archive-title">{site.name} Archive</h2>
      <p>Older adventures and milestones will be collected in the {site.name} Archive.</p>
      <p>
        <a href="/events/archive/">
          Visit the {site.name} Archive{archive.length > 0 && ` (${archive.length} ${archive.length === 1 ? 'event' : 'events'})`}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
