---
// A photo slot. Shows an approved photo when one is provided in
// src/data/photos.ts; otherwise shows an original decorative illustration.
import { Image } from 'astro:assets';
import Scene from './Scene.astro';
import type { PhotoSlot } from '../data/photos';

interface Props {
  slot: PhotoSlot;
  /** Visual shape of the frame. */
  ratio?: 'landscape' | 'square' | 'portrait' | 'wide';
  /** Show the caption under the frame. */
  showCaption?: boolean;
  /** Responsive sizes hint for approved photos. */
  sizes?: string;
}

const { slot, ratio = 'landscape', showCaption = false, sizes = '(min-width: 52rem) 50vw, 100vw' } = Astro.props;

// Focal point uses classes (not inline styles) so the strict Content-Security-Policy still applies.
const focusClasses = [`fx-${slot.focus?.x ?? 50}`, `fy-${slot.focus?.y ?? 50}`];
---

<figure class:list={['photo-frame', `photo-frame--${ratio}`]}>
  <div class:list={['photo-frame-media', ...focusClasses]}>
    {
      slot.image ? (
        <Image src={slot.image} alt={slot.alt ?? ''} widths={[480, 800, 1200]} sizes={sizes} />
      ) : (
        <Scene scene={slot.scene} />
      )
    }
  </div>
  {showCaption && slot.caption && <figcaption>{slot.caption}</figcaption>}
</figure>

<style>
  .photo-frame {
    margin: 0;
  }

  .photo-frame-media {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--cream-200);
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 3;
  }

  .photo-frame--square .photo-frame-media {
    aspect-ratio: 1;
  }

  .photo-frame--portrait .photo-frame-media {
    aspect-ratio: 3 / 4;
  }

  .photo-frame--wide .photo-frame-media {
    aspect-ratio: 16 / 9;
  }

  .photo-frame-media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--fx, 50%) var(--fy, 50%);
  }

  /* Focal-point steps (see FocusStep in src/data/photos.ts). */
  .fx-0 { --fx: 0%; }
  .fx-10 { --fx: 10%; }
  .fx-20 { --fx: 20%; }
  .fx-30 { --fx: 30%; }
  .fx-40 { --fx: 40%; }
  .fx-50 { --fx: 50%; }
  .fx-60 { --fx: 60%; }
  .fx-70 { --fx: 70%; }
  .fx-80 { --fx: 80%; }
  .fx-90 { --fx: 90%; }
  .fx-100 { --fx: 100%; }
  .fy-0 { --fy: 0%; }
  .fy-10 { --fy: 10%; }
  .fy-20 { --fy: 20%; }
  .fy-30 { --fy: 30%; }
  .fy-40 { --fy: 40%; }
  .fy-50 { --fy: 50%; }
  .fy-60 { --fy: 60%; }
  .fy-70 { --fy: 70%; }
  .fy-80 { --fy: 80%; }
  .fy-90 { --fy: 90%; }
  .fy-100 { --fy: 100%; }

  figcaption {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }
</style>
