---
// Date line, status badge, and general destination for one event.
// Shows only what the public event already contains (src/lib/events/present.ts).
import type { SiteEvent } from '../../lib/events/collection';

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
const badgeTone = event.status === 'cancelled' ? 'alert' : event.status === 'postponed' ? 'notice' : 'info';
---

<p class="event-meta">
  <span class="event-when">
    {event.when.prefix && `${event.when.prefix} `}<time datetime={event.when.datetime}>{event.when.text}</time>
  </span>
  {event.badge && <span class:list={['event-badge', `event-badge--${badgeTone}`]}>{event.badge}</span>}
  {
    event.destination && (
      <span class="event-destination">
        <span class="visually-hidden">Place: </span>
        {event.destination}
      </span>
    )
  }
</p>

<style>
  .event-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .event-destination::before {
    content: '·';
    margin-right: var(--space-3);
  }

  /* Words carry the meaning; color only reinforces it. */
  .event-badge {
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--cream-200);
    color: var(--forest-900);
    font-weight: 700;
    line-height: 1.5;
  }

  .event-badge--notice {
    color: var(--khaki-700);
  }

  .event-badge--alert {
    color: var(--ember-700);
  }
</style>
