---
// "Our weekly meetings": what troop meetings are for, and how a prospective
// family can plan a visit. Deliberately NO day, time, place, address, or
// directions: recurring meeting logistics are not public (P2; docs/PRIVACY.md).
import { site, scoutmasterContactHref } from '../data/site';

interface Props {
  /** Heading level used for the card title, to keep page outlines logical. */
  headingLevel?: 2 | 3;
}

const { headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as 'h2' | 'h3';
const Subheading = `h${headingLevel + 1}` as 'h3' | 'h4';
---

<section class="meeting-card" aria-label="Our weekly meetings">
  <Heading class="meeting-title">Our weekly meetings</Heading>
  <p>
    {site.name} meets weekly throughout the year. Meetings give Scouts time to work on advancement, practice skills,
    plan upcoming adventures, build leadership, and have fun together.
  </p>
  <Subheading class="meeting-subtitle">Interested in visiting?</Subheading>
  <p>
    Prospective families are always welcome. Get in touch with the Scoutmaster and we'll help you plan a visit.
  </p>
  <a class="meeting-contact" href={scoutmasterContactHref}>Contact the Scoutmaster</a>
</section>

<style>
  .meeting-card {
    position: relative;
    padding: var(--space-6);
    background: var(--cream-50);
    color: var(--color-text);
    border: 2px solid var(--forest-700);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }

  .meeting-card::before {
    /* Trail-marker accent. */
    content: '';
    position: absolute;
    top: -2px;
    left: var(--space-6);
    width: 3.5rem;
    height: 6px;
    background: var(--ember-600);
    border-radius: 0 0 4px 4px;
  }

  .meeting-title {
    font-size: var(--text-xl);
    color: var(--forest-900);
  }

  .meeting-subtitle {
    margin-top: var(--space-5);
    margin-bottom: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--khaki-700);
  }

  .meeting-contact {
    font-weight: 700;
    color: var(--forest-700);
  }
</style>
